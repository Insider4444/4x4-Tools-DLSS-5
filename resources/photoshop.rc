#include <windows.h>
JSON_PIPL JSON "photoshop-pipl-versioned.json"
101 DIALOGEX 0,0,690,392
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "4x4Tools DLSS5 - Photoshop"
FONT 9,"Segoe UI"
BEGIN
    LTEXT "Full-resolution image enhancement",110,14,12,345,15
    CONTROL "",111,"STATIC",SS_OWNERDRAW,14,36,332,292
    LTEXT "Preview a full-size crop before applying to the whole image.",112,14,333,335,24
    LTEXT "Crop center X %",-1,14,361,69,12
    EDITTEXT 113,84,358,32,15,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Y %",-1,124,361,24,12
    EDITTEXT 114,149,358,32,15,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Preview",115,190,357,66,19
    CONTROL "Original",116,"BUTTON",BS_AUTOCHECKBOX | WS_TABSTOP,264,360,73,13
    CONTROL "",117,"SysTabControl32",WS_TABSTOP,360,12,315,25
    LTEXT "Image presets",-1,370,47,145,12
    COMBOBOX 118,510,44,155,180,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Processing quality",-1,370,298,140,12
    COMBOBOX 119,510,295,155,95,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Full size. Original dimensions and transparency retained.",120,370,324,300,28
    PUSHBUTTON "Updates...",121,370,357,85,21
    DEFPUSHBUTTON "Apply",IDOK,532,357,66,21
    PUSHBUTTON "Cancel",IDCANCEL,606,357,66,21
END
